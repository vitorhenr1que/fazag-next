generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Coordenador {
  id    String   @id @default(uuid())
  nome  String
  email String
  curso String
  text  String   @db.Text
  data  DateTime @default(now())
}

model Leads {
  id        String   @id @default(uuid())
  nome      String
  email     String
  tel       String
  course    String
  contacted Boolean  @default(false)
  data      DateTime @default(now())
}

model Ouvidoria {
  id            String   @id @default(uuid())
  nome          String
  email         String
  motivo        String
  procurouSetor String
  text          String   @db.Text
  vinculo       String
  data          DateTime @default(now())
}

model Post {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String
  image       String
  avatar      String?
  author      String
  published   Boolean
  date        DateTime @default(now())
}

model Vagas {
  id                           String @id @default(uuid())
  administracao                Int
  ciencias_contabeis           Int
  educacao_fisica_bacharelado  Int
  educacao_fisica_licenciatura Int
  enfermagem                   Int
  engenharia_civil             Int
  estetica                     Int
  farmacia                     Int
  fisioterapia                 Int
  nutricao                     Int
  pedagogia                    Int
  psicologia                   Int
  servico_social               Int
  odontologia                  Int    @default(0)
  fonoaudiologia               Int    @default(0)
  direito                      Int    @default(0)
}

model Inscricao {
  id        String   @id @default(uuid())
  nome      String
  telefone  String
  email     String
  cidade    String
  conheceu  String
  ingresso  String
  curso     String
  bolsa     String?
  createdAt DateTime @default(now())
}

model Egressos {
  id         String   @id @default(uuid())
  postName   String?
  nome       String
  email      String
  curso      String
  text       String   @db.Text
  imageUrl   String
  createdAt  DateTime @default(now())
  publicated Boolean  @default(false)
}

model Nusp {
  id           String   @id @default(uuid())
  nome         String
  email        String
  vinculo      String
  horario      String
  createdAt    DateTime @default(now())
  dataAgendada String
}

model NuspSettings {
  id            String   @id @default("settings")
  availableDays String   @default("3") // Comma-separated days of week (0-6)
  updatedAt     DateTime @updatedAt
}

model Vocacional {
  id         String   @id @default(uuid())
  nome       String
  email      String
  courseOne  String
  courseTwo  String
  courseTree String
  createdAt  DateTime @default(now())
  contacted  Boolean  @default(false)
  tel        String
}

model AcademicCalendar {
  id        String   @id @default(uuid())
  year      Int
  semester  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, semester], name: "year_semester")
}

model InstitutionalPublication {
  id              String    @id @default(uuid())
  title           String
  category        String
  fileName        String
  fileKey         String
  fileUrl         String
  fileType        String
  mimeType        String
  size            Int
  description     String?
  published       Boolean   @default(true)
  order           Int       @default(0)
  alwaysPublished Boolean   @default(true)
  publishAt       DateTime?
  unpublishAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Course {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  summary     String?          @db.Text
  description String?          @db.LongText
  degree      String?
  modality    String?
  duration    String?
  shift       String?
  coordinator String?
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  order       Int              @default(0)
  documents   CourseDocument[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CourseDocument {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  category  String
  fileName  String
  fileKey   String
  fileUrl   String
  mimeType  String
  size      Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, category, order])
}

model OrganizationNode {
  id          String             @id @default(uuid())
  title       String
  personName  String?
  description String?            @db.Text
  type        String             @default("DEPARTMENT")
  parentId    String?
  parent      OrganizationNode?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    OrganizationNode[] @relation("OrganizationHierarchy")
  order       Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([parentId, order])
  @@index([type, active, order])
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String?
  isSuperAdmin   Boolean  @default(false)
  permissions    Json?
  active         Boolean  @default(true)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
